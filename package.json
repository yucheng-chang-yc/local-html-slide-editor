{
  "name": "local-html-slide-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsx watch apps/server/index.ts\"",
    "dev:web": "vite --mode browser",
    "start": "node dist/server/apps/server/index.js",
    "serve:test": "node dist/server/apps/server/index.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "pnpm run build && node scripts/run-e2e.mjs",
    "test:e2e:web": "pnpm run build:web && playwright test --config=playwright.web.config.ts",
    "test:e2e:web:chromium": "pnpm run build:web && playwright test --config=playwright.web.config.ts --project=chromium",
    "build": "vite build && tsc -p tsconfig.server.json",
    "build:web": "vite build --mode browser",
    "verify:fixtures": "vitest run --config vitest.config.ts tests/integration/fixtures.test.ts",
    "verify:licenses": "node scripts/create-license-inventory.mjs",
    "verify:language": "node scripts/check-zh-tw.mjs",
    "verify:all": "node scripts/run-verification.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.3",
    "express": "5.2.1",
    "jszip": "3.10.1",
    "parse5": "8.0.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "vite": "8.1.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@types/express": "5.0.6",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "concurrently": "10.0.3",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
